{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://openwebnet-encyclopedia.example/schema/prepared-source-1.json",
  "title": "Sanitized pre-extraction source record",
  "type": "object",
  "additionalProperties": false,
  "required": ["source_id", "source_path", "privacy", "text"],
  "properties": {
    "source_id": {"type": "string", "pattern": "^ownkb:source/[a-z0-9]+(?:-[a-z0-9]+)*$"},
    "source_path": {"type": "string", "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$))[A-Za-z0-9._/-]+$"},
    "privacy": {"$ref": "privacy-metadata.schema.json"},
    "text": {"type": "string"}
  }
}
