{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://openwebnet-ha.github.io/OpenWebNet-Encyclopedia/knowledge/schema/0.1.0/manifest.schema.json",
  "title": "Machine KB manifest (pre-release)",
  "type": "object",
  "additionalProperties": false,
  "required": ["artifacts", "coverage", "format_version", "generator_version", "input_content_sha256", "schema_compatibility_version"],
  "properties": {
    "artifacts": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["format_version", "kind", "path", "sha256"],
        "properties": {
          "format_version": {"type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"},
          "kind": {"enum": ["schema", "llm_corpus", "retrieval_chunks", "claim_records", "reference_registry", "id_registry"]},
          "path": {"type": "string", "pattern": "^knowledge/(?:[A-Za-z0-9_.-]+/)*[A-Za-z0-9_.-]+$"},
          "record_count": {"type": "integer", "minimum": 0},
          "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
        }
      }
    },
    "coverage": {"type": "object", "additionalProperties": false, "required": ["canonical", "guides", "llm_corpus", "references", "retrieval", "claims"], "properties": {"canonical": {"$ref": "#/$defs/metrics"}, "guides": {"$ref": "#/$defs/metrics"}, "llm_corpus": {"$ref": "#/$defs/metrics"}, "references": {"$ref": "#/$defs/metrics"}, "retrieval": {"$ref": "#/$defs/metrics"}, "claims": {"$ref": "#/$defs/claimMetrics"}}},
    "format_version": {"const": "0.1.0"},
    "generator_version": {"const": "ownkb-build-0.8.0"},
    "input_content_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "schema_compatibility_version": {"const": "0.1.0"}
  },
  "$defs": {
    "metrics": {"type": "object", "additionalProperties": false, "properties": {"candidate_sections": {"type": "integer", "minimum": 0}, "documents": {"type": "integer", "minimum": 0}, "emitted_chunks": {"type": "integer", "minimum": 0}, "empty_sections": {"type": "integer", "minimum": 0}, "excluded_documents": {"type": "integer", "minimum": 0}, "included_documents": {"type": "integer", "minimum": 0}, "included_sections": {"type": "integer", "minimum": 0}, "records": {"type": "integer", "minimum": 0}, "remediation_hints": {"type": "integer", "minimum": 0}, "sanitized_documents": {"type": "integer", "minimum": 0}, "sections": {"type": "integer", "minimum": 0}}},
    "claimDomainMetrics": {"type": "object", "additionalProperties": false, "required": ["claims", "documents", "reviewed_nonclaim_sections", "sections", "sections_with_claims"], "properties": {"claims": {"type": "integer", "minimum": 0}, "documents": {"type": "integer", "minimum": 0}, "reviewed_nonclaim_sections": {"type": "integer", "minimum": 0}, "sections": {"type": "integer", "minimum": 0}, "sections_with_claims": {"type": "integer", "minimum": 0}}},
    "claimMetrics": {"type": "object", "additionalProperties": false, "required": ["bounded_domains", "records"], "properties": {"bounded_domains": {"type": "object", "additionalProperties": false, "required": ["device-model", "diagnostics", "functional", "internals", "programming", "protocol", "reverse-engineering", "scenario-engine"], "properties": {"device-model": {"$ref": "#/$defs/claimDomainMetrics"}, "diagnostics": {"$ref": "#/$defs/claimDomainMetrics"}, "functional": {"$ref": "#/$defs/claimDomainMetrics"}, "internals": {"$ref": "#/$defs/claimDomainMetrics"}, "programming": {"$ref": "#/$defs/claimDomainMetrics"}, "protocol": {"$ref": "#/$defs/claimDomainMetrics"}, "reverse-engineering": {"$ref": "#/$defs/claimDomainMetrics"}, "scenario-engine": {"$ref": "#/$defs/claimDomainMetrics"}}}, "records": {"type": "integer", "minimum": 0}}}
  }
}
