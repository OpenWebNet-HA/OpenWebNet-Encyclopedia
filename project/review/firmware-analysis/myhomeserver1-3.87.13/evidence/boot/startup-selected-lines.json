      "text": "\t\t;;"
    },
    {
      "line": 58,
      "text": "  esac"
    },
    {
      "line": 145,
      "text": "\tfor i in /etc/rc$runlevel.d/S*"
    },
    {
      "line": 146,
      "text": "\tdo"
    },
    {
      "line": 147,
      "text": "\t\t[ ! -f $i ] && continue"
    },
    {
      "line": 148,
      "text": ""
    },
    {
      "line": 149,
      "text": "\t\tif [ $previous != N ] && [ $previous != S ]"
    },
    {
      "line": 150,
      "text": "\t\tthen"
    },
    {
      "line": 151,
      "text": "\t\t\t#"
    },
    {
      "line": 152,
      "text": "\t\t\t# Find start script in previous runlevel and"
    },
    {
      "line": 153,
      "text": "\t\t\t# stop script in this runlevel."
    },
    {
      "line": 154,
      "text": "\t\t\t#"
    },
    {
      "line": 155,
      "text": "\t\t\tsuffix=${i#/etc/rc$runlevel.d/S[0-9][0-9]}"
    },
    {
      "line": 156,
      "text": "\t\t\tstop=/etc/rc$runlevel.d/K[0-9][0-9]$suffix"
    },
    {
      "line": 157,
      "text": "\t\t\tprevious_start=/etc/rc$previous.d/S[0-9][0-9]$suffix"
    },
    {
      "line": 158,
      "text": "\t\t\t#"
    },
    {
      "line": 159,
      "text": "\t\t\t# If there is a start script in the previous level"
    },
    {
      "line": 160,
      "text": "\t\t\t# and _no_ stop script in this level, we don't"
    },
    {
      "line": 161,
      "text": "\t\t\t# have to re-start the service."
    },
    {
      "line": 162,
      "text": "\t\t\t#"
    },
    {
      "line": 163,
      "text": "\t\t\t[ -f $previous_start ] && [ ! -f $stop ] && continue"
    },
    {
      "line": 164,
      "text": "\t\tfi"
    },
    {
      "line": 165,
      "text": "\t\tcase \"$runlevel\" in"
    },
    {
      "line": 166,
      "text": "\t\t\t0|6)"
    },
    {
      "line": 167,
      "text": "\t\t\t\tstartup $i stop"
    },
    {
      "line": 168,
      "text": "\t\t\t\t;;"
    },
    {
      "line": 169,
      "text": "\t\t\t*)"
    },
    {
      "line": 170,
      "text": "\t\t\t\tstartup $i start"
    }
