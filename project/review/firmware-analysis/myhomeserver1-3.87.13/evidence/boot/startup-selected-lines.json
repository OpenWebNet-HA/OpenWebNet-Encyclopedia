    {
      "line": 41,
      "text": "startup() {"
    },
    {
      "line": 42,
      "text": "  # Handle verbosity"
    },
    {
      "line": 43,
      "text": "  [ \"$VERBOSE\" = very ] && echo \"INIT: Running $@...\""
    },
    {
      "line": 44,
      "text": ""
    },
    {
      "line": 45,
      "text": "  case \"$1\" in"
    },
    {
      "line": 46,
      "text": "\t*.sh)"
    },
    {
      "line": 47,
      "text": "\t\t# Source shell script for speed."
    },
    {
      "line": 48,
      "text": "\t\t("
    },
    {
      "line": 49,
      "text": "\t\t\ttrap - INT QUIT TSTP"
