            "line": 103,
            "text": "# Run scripts in /etc/init.d/scripts    "
          },
          {
            "line": 104,
            "text": "foreach n [lsort [glob -nocomplain /etc/init.d/scripts/S*]] {"
          },
          {
            "line": 105,
            "text": "    try [list source $n]"
          },
          {
            "line": 106,
            "text": "}"
          },
          {
            "line": 120,
            "text": "# Run user applications in /etc/applications"
          },
          {
            "line": 121,
            "text": "foreach n [lsort [glob -nocomplain /etc/applications/*]] {"
          },
          {
            "line": 122,
            "text": "    if ![file isfile $n] continue; # skip directories"
          },
          {
            "line": 123,
            "text": "    if ![sys_fork] {"
          },
          {
            "line": 124,
            "text": "\tcatch {unset pid}"
          },
          {
            "line": 125,
            "text": "        newcmdname [file tail $n]"
          },
          {
            "line": 126,
            "text": "        source $n; exit"
          },
          {
            "line": 127,
            "text": "    } else {"
          }
