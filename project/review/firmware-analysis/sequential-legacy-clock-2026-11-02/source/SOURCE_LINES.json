    {
      "bytes": 294,
      "path": "work/f453av-firmware/3.0.14/analysis/rootfs/etc/init.d/scripts/S10rtc_verify",
      "product": "F453AV",
      "relative_path": "etc/init.d/scripts/S10rtc_verify",
      "role": "NEW selected local clock-flag/read/branch/request script contract",
      "safe_selected_lines": [
        {
          "line": 1,
          "text": "puts \"S10rtc_verify\""
        },
        {
          "line": 2,
          "text": "set t [open /proc/sys/dev/btweb/rtc_invalid r]"
        },
        {
          "line": 3,
          "text": "gets $t line"
        },
        {
          "line": 4,
          "text": "scan $line %d num"
        },
        {
          "line": 5,
          "text": "if [expr $num==1] then {"
        },
        {
          "line": 6,
          "text": " puts \"Date Wrong\""
        },
        {
          "line": 7,
          "text": " date -s 2000.1.1-00:00:00"
        },
        {
          "line": 8,
          "text": "# hwclock --systohc --utc"
        },
        {
          "line": 9,
          "text": " puts \"Fixed only system clock\""
        },
        {
          "line": 10,
          "text": "#  puts \"Doing nothing\""
        },
        {
          "line": 11,
          "text": "} else {puts \"Date Correct\"}"
        },
        {
          "line": 12,
          "text": ""
        },
        {
          "line": 13,
          "text": "close $t"
        }
      ],
      "sha256": "0f6e3f123e1ad9cab1fcd00d87ce3617cfd2d5b50db78e457c385582fb983d10",
      "version": "3.0.14",
      "view": "normal"
    },
    {
      "bytes": 231,
      "path": "work/f453av-firmware/3.0.14/analysis/rootfs/bin/hwtosys.tcl",
      "product": "F453AV",
      "relative_path": "bin/hwtosys.tcl",
      "role": "NEW selected wrapper contract; natural caller OPEN and separate from init-to-S10 contract",
      "safe_selected_lines": [
        {
          "line": 1,
          "text": "#!/bin/ettclsh"
        },
        {
          "line": 2,
          "text": "set str1 \"armv5tel\""
        },
        {
          "line": 3,
          "text": "set str [exec uname -m]"
        },
        {
          "line": 4,
          "text": "#puts $str"
        },
        {
          "line": 5,
          "text": "set str1 \"armv5tel\""
        },
        {
          "line": 6,
          "text": "if [string compare $str $str1] then {"
        },
        {
          "line": 7,
          "text": "# puts \"SA1110\""
        },
        {
          "line": 8,
          "text": " exec rtc-rw r"
        },
        {
          "line": 9,
          "text": " } else {"
        },
        {
          "line": 10,
          "text": "# puts \"PXA255\" "
        },
        {
          "line": 11,
          "text": " exec hwclock --hctosys --utc"
        },
        {
          "line": 12,
          "text": "}"
        },
        {
          "line": 13,
          "text": ""
        },
        {
          "line": 14,
          "text": "#puts \"end\""
        }
      ],
      "sha256": "ae5d328983802c1540debd016fc10618d4b99654d406ccacca32e4fbdbea1963",
